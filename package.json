{
  "name": "oracion-app",
  "version": "1.0.0",
  "private": true,
  "description": "App de oración y versículos con IA: oración personalizada, diario, capilla de velas y acompañante.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch server/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client install --no-audit --no-fund && npm --prefix client run build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.136.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "geoip-country": "^5.0.202610170130",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "pg": "^8.23.1",
    "stripe": "^23.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "sharp": "^0.35.5"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  }
}
